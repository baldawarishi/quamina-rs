#!/bin/sh
#
# Pre-commit hook: runs fast tests, clippy, format check, and an incremental
# mutation check on the changed lines. Full test suite + whole-tree mutation
# sweep run in CI.
#
# MAINTAINER NOTE: If you add new slow tests (>5s), add them to --skip below.
# Current skips: stress (fuzz tests ~80s), citylots (large data ~10s), regexp_validity (~8s)
#

set -e

echo '+cargo test --lib (output suppressed unless failure)'
TEST_OUTPUT=$(cargo test --lib -- --skip stress --skip citylots --skip regexp_validity --test-threads=1 2>&1) || {
    echo "$TEST_OUTPUT"
    exit 1
}
echo "$TEST_OUTPUT" | grep -E '^test result:'

echo '+cargo clippy --all-targets --all-features -- -D warnings'
cargo clippy --all-targets --all-features -- -D warnings

echo '+cargo fmt -- --check'
cargo fmt -- --check

# Incremental mutation check: mutate only the lines this commit changes, the
# same gate CI's `incremental` job runs (and using the same .cargo/mutants.toml,
# so equivalents listed in exclude_re are already filtered out). A commit must
# not pass with missed or timed-out changed-line mutants.
if [ "${SKIP_MUTANTS:-0}" = "1" ]; then
    echo "SKIP_MUTANTS=1: skipping changed-line mutation check"
    exit 0
fi

if ! command -v cargo-mutants >/dev/null 2>&1; then
    echo "cargo-mutants is required for the local mutation check"
    exit 1
fi

MUT_DIFF=$(mktemp)
trap 'rm -f "$MUT_DIFF"' EXIT
# Working tree vs HEAD, matching the source cargo-mutants will mutate.
git diff HEAD -- '*.rs' > "$MUT_DIFF"
if [ -s "$MUT_DIFF" ]; then
    echo '+cargo mutants -vV -j 4 --timeout 10 --test-tool nextest --in-diff'
    status=0
    if command -v caffeinate >/dev/null 2>&1; then
        caffeinate -i cargo mutants -vV --no-shuffle -j 4 --timeout 10 --test-tool nextest --in-diff "$MUT_DIFF" || status=$?
    else
        cargo mutants -vV --no-shuffle -j 4 --timeout 10 --test-tool nextest --in-diff "$MUT_DIFF" || status=$?
    fi
    if [ "$status" -ne 0 ]; then
        echo "mutation check failed (exit $status): changed-line mutants were missed, timed out, or the run failed"
        echo "Add a test, or if the mutant is a genuine equivalent,"
        echo "add it to .cargo/mutants.toml exclude_re."
        exit 1
    fi
fi
