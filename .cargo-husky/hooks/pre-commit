#!/bin/sh
#
# Pre-commit hook: runs fast tests, clippy, format check, and an incremental
# mutation check on the changed lines. Full test suite + whole-tree mutation
# sweep run in CI.
#
# MAINTAINER NOTE: If you add new slow tests (>5s), add them to --skip below.
# Current skips: stress (fuzz tests ~80s), citylots (large data ~10s), regexp_validity (~8s)
#

set -e

echo '+cargo test --lib (output suppressed unless failure)'
TEST_OUTPUT=$(cargo test --lib -- --skip stress --skip citylots --skip regexp_validity --test-threads=1 2>&1) || {
    echo "$TEST_OUTPUT"
    exit 1
}
echo "$TEST_OUTPUT" | grep -E '^test result:'

echo '+cargo clippy --all-targets --all-features -- -D warnings'
cargo clippy --all-targets --all-features -- -D warnings

echo '+cargo fmt -- --check'
cargo fmt -- --check

# Incremental mutation check: mutate only the lines this commit changes, the
# same gate CI's `incremental` job runs (and using the same .cargo/mutants.toml,
# so equivalents listed in exclude_re are already filtered out). Local feedback
# only — CI is authoritative.
#
# Kept under ~1 minute by costing the diff first: `--list` is near-instant, and
# a mutant runs in ~3s on top of a ~10s baseline build, so anything past
# MUTANTS_MAX mutants would blow the budget and is left for CI. Skipped entirely
# when cargo-mutants is absent or SKIP_MUTANTS=1.
MUTANTS_MAX=${MUTANTS_MAX:-15}
if [ "${SKIP_MUTANTS:-0}" != "1" ] && command -v cargo-mutants >/dev/null 2>&1; then
    MUT_DIFF=$(mktemp)
    trap 'rm -f "$MUT_DIFF"' EXIT
    # Working tree vs HEAD, matching the source cargo-mutants will mutate.
    git diff HEAD -- '*.rs' > "$MUT_DIFF"
    if [ -s "$MUT_DIFF" ]; then
        N=$(cargo mutants --in-diff "$MUT_DIFF" --list 2>/dev/null | wc -l | tr -d ' ')
        if [ "$N" -eq 0 ]; then
            : # no mutable production lines changed
        elif [ "$N" -gt "$MUTANTS_MAX" ]; then
            echo "+cargo mutants --in-diff: $N mutants exceeds local budget ($MUTANTS_MAX); leaving to CI"
        else
            echo "+cargo mutants --in-diff ($N mutants)"
            status=0
            cargo mutants --no-shuffle --in-diff "$MUT_DIFF" --timeout 20 || status=$?
            if [ "$status" -ne 0 ]; then
                echo "mutation check failed (exit $status): a changed line has no test"
                echo "killing it. Add a test, or if the mutant is a genuine equivalent,"
                echo "add it to .cargo/mutants.toml exclude_re. Bypass: SKIP_MUTANTS=1 git commit"
                exit 1
            fi
        fi
    fi
fi
